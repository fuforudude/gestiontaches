{
  "name": "taches",
  "private": true,
  "type": "module",
  "description": "Mes tâches par projet, tenues à jour par Claude (serveur MCP) et cochées depuis le site",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run build && node --env-file-if-exists=.env --disable-warning=ExperimentalWarning dist/serveur.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "verifier": "tsc --noEmit && eslint . && vitest run --coverage",
    "admin": "node --env-file-if-exists=.env dist/outils/admin.js",
    "jeton": "node --env-file-if-exists=.env dist/outils/jeton.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
